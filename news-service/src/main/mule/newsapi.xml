    <flow name="get:\news\(newsId):newsapi-config">
        <ee:transform doc:name="Transform Message">
            <ee:variables>
                <ee:set-variable variableName="newsId">attributes.uriParams.'newsId'</ee:set-variable>
            </ee:variables>
        </ee:transform>
        <ee:transform doc:name="Transform Message">
            <ee:message>
                <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
  newsId: vars.newsId,
  newsHeadline: "Corona Virus Spreading",
  newsDetails: "Corona Virus Spreading",
  reporterName: "Ruchi Saini",
  newsType: "General",
  newsAgency: {
    agencyName: "USA Agency",
    country: "USA"
  }
} as Object {encoding: "UTF-8", mediaType: "application/json"}]]></ee:set-payload>
            </ee:message>
        </ee:transform>
    </flow>
    <flow name="post:\news:application\json:newsapi-config">
        <ee:transform doc:name="Transform Message">
            <ee:message>
                <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
  statusCode: 201,
  message: "News Resource is created"
} as Object {encoding: "UTF-8", mediaType: "application/json"}]]></ee:set-payload>
            </ee:message>
        </ee:transform>
    </flow>
</mule>
